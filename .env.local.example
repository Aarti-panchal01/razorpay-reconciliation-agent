NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter (OpenAI-compatible) — powers the ambiguous-case resolver.
# Free-tier models work (check https://openrouter.ai/models?max_price=0
# for what's currently free). Without this set, the resolver correctly
# escalates every ambiguous case instead of guessing — see
# src/resolver/ambiguous-resolver.ts and its tests.
OPENROUTER_API_KEY=
# Optional override; defaults to a free model in ambiguous-resolver.ts
RESOLVER_MODEL=
